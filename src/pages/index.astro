---
import "../style.css";
import Term from "../terms/F26/Term.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Menu</title>
  </head>
  <body>
    <Term />
    <div class="menu-status" role="status" aria-live="polite">
      <span class="status-message">Loading menu…</span>
      <button class="retry-button" type="button" hidden>Retry</button>
    </div>
    <main class="menu-container" aria-label="Menu" aria-busy="true"></main>
    <footer class="legend" aria-label="Menu symbols" hidden></footer>
    <script>
      import "../main.ts";
    </script>
  </body>
</html>
